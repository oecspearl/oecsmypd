{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --include=optional",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.js": {
      "maxDuration": 60
    },
    "app/api/courses/import/moodle/route.ts": {
      "maxDuration": 300
    },
    "app/api/ai/lesson-from-document/outline/route.ts": {
      "maxDuration": 120
    },
    "app/api/ai/lesson-from-document/lesson/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-digests",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/assignment-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/check-completions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/crm-campaigns",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/crm-workflows",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/crm-lifecycle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/crm-engagement",
      "schedule": "0 3 * * *"
    }
  ]
}
